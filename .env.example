# Substitua pelos valores locais antes de iniciar os serviços.
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/north
DB_USERNAME=north
DB_PASSWORD=replace_with_the_same_local_password
# Gere uma chave aleatória com: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_base64_secret_of_at_least_32_bytes
JWT_EXPIRATION_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
