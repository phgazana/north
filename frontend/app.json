{
  "expo": {
    "name": "NORTH",
    "slug": "north",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "north",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/north-app-icon.png",
    "splash": {
      "image": "./assets/images/north-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B132B"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/north-app-icon.png",
        "backgroundColor": "#0B132B"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/north-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
